erDiagram
    stroke {
        uuid id PK
        varchar code
        varchar name_en
        varchar name_ar
    }
    distance {
        uuid id PK
        varchar code
        integer meters
    }
    club {
        uuid id PK
        varchar name_en
        varchar name_ar
        varchar location_en
        varchar location_ar
        timestamptz created_at
    }
    app_user {
        uuid id PK
        varchar username UK
        varchar email UK
        text password_hash
        varchar name_en
        varchar name_ar
        gender gender
        date dob
        varchar phone
        varchar(4) avatar_initials
        user_role role
        boolean is_first_login
        timestamptz created_at
    }
    captain {
        uuid id PK
        uuid user_id FK,UK
        captain_type captain_type
        varchar(14) national_id UK
        timestamptz created_at
    }
    head_coach {
        uuid id PK
        uuid user_id FK,UK
        varchar(14) national_id UK
        timestamptz created_at
    }
    app_user ||--o| captain : "is"
    app_user ||--o| head_coach : "is"

    swimmer {
        uuid id PK
        uuid user_id FK,UK
        varchar uid UK
        uuid club_id FK
        uuid championship_club_id FK
        varchar(3) blood_type
        timestamptz created_at
        timestamptz updated_at
    }
    guardian {
        uuid id PK
        uuid swimmer_id FK
        guardian_relation relation
        varchar name
        varchar(14) national_id
        varchar phone
    }
    medical_exam {
        uuid id PK
        uuid swimmer_id FK
        date exam_date
        fitness_assessment internal_med
        fitness_assessment heart_assess
        fitness_assessment spine_assess
        numeric(4,1) hemoglobin
        numeric(5,1) height_cm
        numeric(5,1) weight_kg
        timestamptz created_at
    }
    body_measurement {
        uuid id PK
        uuid swimmer_id FK
        date measured_at
        numeric(5,1) right_arm_cm
        numeric(5,1) left_arm_cm
        numeric(5,1) right_leg_cm
        numeric(5,1) left_leg_cm
        numeric(5,1) torso_cm
        numeric(5,1) bust_diameter_cm
        numeric(5,1) waist_diameter_cm
    }
    swimmer_specialization {
        uuid swimmer_id FK,UK
        uuid stroke_id FK,UK
    }

    club ||--o{ swimmer : "trains"
    club ||--o{ swimmer : "represents"
    app_user ||--o| swimmer : "logs in as"
    swimmer ||--o{ guardian : "has"
    swimmer ||--o{ medical_exam : "examined in"
    swimmer ||--o{ body_measurement : "measured in"
    swimmer ||--o{ swimmer_specialization : "specializes"
    stroke ||--o{ swimmer_specialization : "chosen in"

    inbody_reading {
        uuid id PK
        uuid swimmer_id FK
        date reading_date
        numeric(5,1) height_cm
        numeric(5,1) weight_kg
        numeric(4,1) fat_pct
        numeric(4,1) muscle_pct
        numeric(4,2) bone_density
        numeric(4,2) body_density
        uuid recorded_by FK
        timestamptz created_at
    }
    medical_test {
        uuid id PK
        varchar name_en
        varchar name_ar
        varchar unit
        numeric(8,2) lower_bound
        numeric(8,2) upper_bound
        uuid created_by FK
        timestamptz created_at
    }
    health_reading {
        uuid id PK
        uuid swimmer_id FK
        uuid medical_test_id FK
        numeric(8,2) value
        date reading_date
        uuid recorded_by FK
    }
    observation {
        uuid id PK
        uuid swimmer_id FK
        observation_category category
        varchar field_label
        varchar value
        record_status status
        date observed_date
        uuid recorded_by FK
    }
    feedback_entry {
        uuid id PK
        uuid swimmer_id FK
        smallint rating
        feedback_category category
        text comment
        uuid author_id FK
        date entry_date
    }

    swimmer ||--o{ inbody_reading : "records"
    swimmer ||--o{ health_reading : "records"
    medical_test ||--o{ health_reading : "measured by"
    swimmer ||--o{ observation : "noted on"
    swimmer ||--o{ feedback_entry : "receives"

    attendance_session {
        uuid id PK
        uuid club_id FK
        date session_date
        uuid stroke_id FK
        uuid coach_id FK
    }
    attendance_record {
        uuid id PK
        uuid session_id FK,UK
        uuid swimmer_id FK,UK
        attendance_status status
        text coach_note_en
        text coach_note_ar
    }

    club ||--o{ attendance_session : "holds"
    stroke ||--o{ attendance_session : "grouped by"
    attendance_session ||--o{ attendance_record : "includes"
    swimmer ||--o{ attendance_record : "attends"

    competition_event {
        uuid id PK
        varchar name_en
        varchar name_ar
        date start_date
        date end_date
        varchar location_en
        varchar location_ar
        competition_status status
        uuid created_by FK
    }
    championship_enrollment {
        uuid id PK
        uuid event_id FK,UK
        uuid swimmer_id FK,UK
    }
    competition_day {
        uuid id PK
        uuid event_id FK
        varchar label_en
        varchar label_ar
        date day_date
    }
    race_session {
        uuid id PK
        uuid day_id FK
        uuid stroke_id FK
        uuid distance_id FK
        time scheduled_time
    }
    race_assignment {
        uuid id PK
        uuid race_session_id FK,UK
        uuid swimmer_id FK,UK
    }
    race_result {
        uuid id PK
        uuid race_session_id FK,UK
        uuid swimmer_id FK,UK
        integer time_ms
        integer points
        integer rank
        boolean is_personal_best
        uuid recorded_by FK
    }

    competition_event ||--o{ championship_enrollment : "enrolls"
    swimmer ||--o{ championship_enrollment : "enrolled in"
    competition_event ||--o{ competition_day : "spans"
    competition_day ||--o{ race_session : "schedules"
    stroke ||--o{ race_session : "of stroke"
    distance ||--o{ race_session : "of distance"
    race_session ||--o{ race_assignment : "assigns"
    swimmer ||--o{ race_assignment : "swims in"
    race_session ||--o{ race_result : "produces"
    swimmer ||--o{ race_result : "achieves"
